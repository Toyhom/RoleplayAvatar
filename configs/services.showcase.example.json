{
  "services": {
    "controller": {
      "python": "${AVATAR_LLM_PYTHON}",
      "script": "services/llm_service.py",
      "model_role": "controller",
      "port": 18110,
      "args": ["--role", "controller"]
    },
    "asr": {
      "python": "${AVATAR_ASR_PYTHON}",
      "script": "services/whisper_service.py",
      "model_role": "asr",
      "port": 18140
    },
    "tts": {
      "python": "${AVATAR_TTS_PYTHON}",
      "script": "services/speech_service.py",
      "model_role": "tts",
      "port": 18120
    },
    "audio_face": {
      "python": "${AVATAR_AUDIO_FACE_PYTHON}",
      "script": "services/audio_face_service.py",
      "model_role": "audio_face",
      "port": 18130
    }
  }
}
