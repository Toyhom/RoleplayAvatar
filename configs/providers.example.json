    },
    "performance_director": {},
    "initiative": {"provider": "deepseek", "model": "deepseek-chat"},
    "character_design": {"provider": "anthropic", "model": "YOUR_CLAUDE_MODEL_ID", "require_key": true},
    "voice_direction": {"provider": "openai", "model": "YOUR_OPENAI_MODEL_ID", "require_key": true},
    "vision": {"provider": "qwen", "model": "qwen-vl-plus", "extra_body": {"enable_thinking": false}}
  },
  "models": {"vision": {"adapter": "api"}},
  "prompts": {}
