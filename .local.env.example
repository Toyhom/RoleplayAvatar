# Copy to .local.env. This file is sourced as shell configuration.
AVATAR_ENV_PREFIX=/path/to/conda/envs/roleplay-avatar-runtime
AVATAR_MODEL_ROOT=/path/to/shared/models
AVATAR_PORT=18080
# Only used by the cluster-specific demo.py launcher.
AVATAR_OWNER=your-linux-account
AVATAR_LLM_PYTHON=/path/to/existing/llm-env/bin/python
AVATAR_TTS_PYTHON=/path/to/conda/envs/roleplay-avatar-cosyvoice/bin/python
# Live is the default; AVATAR_MODE=replay explicitly selects diagnostic tones.
AVATAR_QWEN_PYTHON=/path/to/conda/envs/roleplay-avatar-qwen-tts/bin/python

# Character generation: local on a standalone workstation, gpuq on a GPUQ cluster.
AVATAR_CREATION_RUNNER=local
AVATAR_VISION_PYTHON=/path/to/envs/roleplay-avatar-vision/bin/python
AVATAR_PORTRAIT_PYTHON=/path/to/envs/roleplay-avatar-portrait/bin/python
# Needed only for optional 3D creation.
# AVATAR_ASSET_PYTHON=/path/to/envs/roleplay-avatar-anigen/bin/python
AVATAR_HIDE_LEGACY=1

# Replace only the roleplay model through an OpenAI-compatible inference endpoint.
# Keep local for the bundled services/llm_service.py service.
AVATAR_LLM_BACKEND=local
AVATAR_LLM_URL=http://127.0.0.1:18110
AVATAR_LLM_MODEL=Qwen3-8B
# AVATAR_LLM_BACKEND=openai
# AVATAR_LLM_URL=http://127.0.0.1:8000/v1
# AVATAR_LLM_API_KEY='set-only-in-your-local-file-if-needed'
AVATAR_TTS_URL=http://127.0.0.1:18120

# Default compact image editor; qwen_image selects the larger optional model.
AVATAR_IMAGE_BACKEND=flux2

# Dedicated CPU landmarks; this environment uses headless OpenCV.
AVATAR_FACE_PYTHON=/path/to/envs/roleplay-avatar-face/bin/python
AVATAR_MESH_RENDERER=color

# Learned speech-to-face service. Omit both for the explicit energy-rhythm fallback.
AVATAR_AUDIO_FACE_PYTHON=/path/to/envs/roleplay-avatar-audio2face/bin/python
AVATAR_AUDIO_FACE_URL=http://127.0.0.1:18130

# Optional local microphone transcription; the vision environment can also run Whisper.
AVATAR_ASR_PYTHON=/path/to/envs/roleplay-avatar-vision/bin/python
AVATAR_ASR_URL=http://127.0.0.1:18140

# Each model path can override the default layout (guides/models.md).
# AVATAR_MODELS_CONFIG=/path/to/project/configs/models.local.json
# AVATAR_ROLEPLAY_MODEL_PATH=/path/to/models/Qwen3-8B
# AVATAR_VOICE_DESIGN_MODEL_PATH=/path/to/models/Qwen3-TTS-VoiceDesign
# AVATAR_TTS_MODEL_PATH=/path/to/models/CosyVoice3
# AVATAR_SEGMENTATION_MODEL_PATH=/path/to/models/matting/birefnet-general.onnx
# CPU API-only mode. API-key auth is intended for backend clients / an authenticated proxy.
AVATAR_HEADLESS=0
# AVATAR_API_KEY='set-in-your-private-environment'
# Optional service port overrides for the cluster launcher.
AVATAR_LLM_PORT=18110
AVATAR_TTS_PORT=18120
# Project agent loopback forwards to other creation-worker nodes (cluster launcher only).
# AVATAR_AGENT_WORKER_NODES=system-2,system-3

# Hardware and controller options for the GPUQ launcher.
AVATAR_LLM_GPUS=1
AVATAR_LLM_SERVICE=services/llm_service.py
AVATAR_ASR_PORT=18140
AVATAR_ASR_SERVICE=services/whisper_service.py
AVATAR_ASR_LANGUAGE=auto
AVATAR_CREATION_GPUS=1
# A CoSER actor can use a separate Qwen control service.
# AVATAR_CONTROLLER_PYTHON=/path/to/envs/avatar-vision/bin/python
# AVATAR_CONTROLLER_PORT=18111
# AVATAR_CONTROLLER_GPUS=1
# Provider and prompt routing examples: configs/providers.example.json, configs/research.example.json
# Group lightweight services within a shared GPU allocation.
# AVATAR_SERVICE_GROUP_CONFIG=/absolute/project/configs/services.local.json
# AVATAR_LLM_IN_GROUP=1
# AVATAR_CONTROL_GPUS=1
